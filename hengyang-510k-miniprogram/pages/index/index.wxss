page { background: #071719; }

.page-shell { min-height: 100vh; padding: 0 28rpx calc(36rpx + env(safe-area-inset-bottom)); background: radial-gradient(circle at 15% 8%, rgba(215, 161, 69, .12), transparent 34%), #071719; }
.welcome-screen { min-height: 100vh; display: flex; flex-direction: column; justify-content: center; padding: 60rpx 30rpx; }
.brand-mark, .mini-mark { display: grid; place-items: center; color: #1a2822; background: linear-gradient(135deg, #ffd887, #c9953f); font-weight: 900; }
.brand-mark { width: 86rpx; height: 86rpx; border-radius: 26rpx 26rpx 26rpx 7rpx; margin-bottom: 76rpx; font-size: 36rpx; box-shadow: 0 12rpx 35rpx rgba(234, 184, 83, .22); }
.kicker, .eyebrow, .call-eyebrow { color: #f4c56a; letter-spacing: .2em; font-size: 20rpx; }
.title { margin-top: 26rpx; color: #fff1c8; font: 900 94rpx/1 Georgia, serif; letter-spacing: .06em; }
.title text { color: #e67a63; }
.intro { max-width: 610rpx; margin-top: 28rpx; color: #a9c7bd; font-size: 27rpx; line-height: 1.8; }
.feature-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 44rpx 0; }
.feature-row text { padding: 13rpx 18rpx; border: 1rpx solid rgba(255, 255, 255, .12); border-radius: 999rpx; color: #d5e2c9; background: rgba(255, 255, 255, .045); font-size: 21rpx; }
.primary-btn, .soft-btn, .text-btn, .close-text, .tiny-btn, .copy-btn { border-radius: 18rpx; line-height: 1.2; font-size: 26rpx; }
.primary-btn { color: #17251f; background: linear-gradient(135deg, #ffe3a2, #f4c56a); font-weight: 800; }
.soft-btn { color: #fff8ea; background: rgba(255, 255, 255, .1); border: 1rpx solid rgba(255, 255, 255, .16); }
.large { width: 100%; padding: 25rpx 20rpx; }
.text-btn { width: 100%; margin-top: 16rpx; color: #94b4af; background: transparent; }

.lobby-screen { padding: 48rpx 0; }
.page-head, .game-head, .room-code-head, .button-row, .join-row, .action-bar, .tool-row { display: flex; align-items: center; justify-content: space-between; }
.page-head { margin-bottom: 26rpx; }
.page-title { color: #fff1c8; font-size: 36rpx; font-weight: 800; }
.close-text { padding: 12rpx 20rpx; color: #94b4af; background: transparent; }
.glass-card, .info-card, .log-card { margin-top: 22rpx; padding: 28rpx; border: 1rpx solid rgba(255, 255, 255, .1); border-radius: 24rpx; background: rgba(12, 32, 33, .82); box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, .2); }
.helper { color: #94b4af; font-size: 23rpx; line-height: 1.7; }
.form-label { margin-top: 28rpx; margin-bottom: 10rpx; color: #c7ddd1; font-size: 22rpx; }
.address-label { margin-top: 22rpx; }
.input { height: 84rpx; padding: 0 22rpx; border: 1rpx solid rgba(255, 255, 255, .14); border-radius: 16rpx; color: #eff9e7; background: rgba(0, 0, 0, .2); font-size: 24rpx; }
.button-row { gap: 14rpx; margin-top: 26rpx; }
.button-row button { flex: 1; }
.join-row { gap: 14rpx; margin-top: 16rpx; }
.room-input { flex: 1; letter-spacing: .18em; }
.join-btn { width: 160rpx; }
.status { min-height: 42rpx; margin-top: 23rpx; padding: 18rpx; border-radius: 14rpx; color: #acd6c4; background: rgba(88, 189, 160, .09); font-size: 22rpx; line-height: 1.5; }
.status.error { color: #ffb3a4; background: rgba(216, 94, 75, .13); }
.room-card { border-color: rgba(244, 197, 106, .24); }
.muted, .room-state, .round-status, .score-members { color: #94b4af; font-size: 21rpx; }
.room-code { margin-top: 10rpx; color: #ffe3a2; font: 900 54rpx/1 Georgia, serif; letter-spacing: .18em; }
.copy-btn { padding: 14rpx 18rpx; color: #fff8ea; background: rgba(255, 255, 255, .09); }
.room-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12rpx; margin-top: 24rpx; }
.room-seat { min-height: 132rpx; padding: 16rpx 7rpx; border: 1rpx solid rgba(255, 255, 255, .1); border-radius: 16rpx; background: rgba(255, 255, 255, .035); text-align: center; }
.room-seat.ready { border-color: rgba(159, 224, 201, .35); background: rgba(88, 189, 160, .1); }
.room-avatar, .seat-avatar { display: grid; place-items: center; color: #19312b; background: #8bd2bc; font-weight: 900; }
.room-avatar { width: 54rpx; height: 54rpx; margin: 0 auto 11rpx; border-radius: 17rpx; font-size: 22rpx; }
.room-seat.empty .room-avatar { color: #72918b; background: rgba(255, 255, 255, .08); }
.room-name { overflow: hidden; color: #e5f0df; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }

.game-screen { padding: 24rpx 0 46rpx; }
.game-head { gap: 16rpx; }
.brand-line { display: flex; align-items: center; gap: 12rpx; }
.mini-mark { width: 42rpx; height: 42rpx; border-radius: 12rpx 12rpx 12rpx 3rpx; font-size: 20rpx; }
.game-name { color: #fff1c8; font-size: 31rpx; font-weight: 800; }
.round-status { margin-top: 8rpx; font-size: 18rpx; }
.round-pill { flex: none; padding: 13rpx 16rpx; border: 1rpx solid rgba(244, 197, 106, .24); border-radius: 999rpx; color: #ffe3a2; background: rgba(244, 197, 106, .1); font-size: 18rpx; }
.score-strip { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin: 24rpx 0 18rpx; }
.score-team { position: relative; min-height: 120rpx; padding: 18rpx 22rpx; border: 1rpx solid rgba(244, 197, 106, .2); border-radius: 18rpx; background: rgba(244, 197, 106, .08); }
.score-team.opponent { border-color: rgba(216, 94, 75, .2); background: rgba(216, 94, 75, .07); }
.score-label { color: #ffe3a2; font-size: 22rpx; font-weight: 800; }
.score-team.opponent .score-label { color: #ffb3a4; }
.score-members { margin-top: 7rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 18rpx; }
.score-number { position: absolute; right: 20rpx; bottom: 14rpx; color: #ffe3a2; font: 900 45rpx/1 Georgia, serif; }
.score-team.opponent .score-number { color: #ffb3a4; }
.table { position: relative; height: 920rpx; overflow: hidden; border: 1rpx solid rgba(244, 197, 106, .25); border-radius: 28rpx; background: radial-gradient(ellipse at center, #1b554b 0%, #103a39 55%, #0a282b 100%); }
.table::before { content: "衡阳 · 510K"; position: absolute; top: 37%; left: 50%; transform: translate(-50%, -50%); color: rgba(255, 236, 178, .09); font: 800 48rpx/1 Georgia, serif; letter-spacing: .16em; white-space: nowrap; }
.seat { position: absolute; z-index: 2; display: flex; align-items: center; gap: 12rpx; min-width: 210rpx; }
.seat-bottom { left: 24rpx; bottom: 232rpx; }
.seat-left { left: 22rpx; top: 39%; }
.seat-top { top: 25rpx; left: 50%; transform: translateX(-50%); flex-direction: column; gap: 8rpx; }
.seat-right { top: 39%; right: 22rpx; flex-direction: row-reverse; }
.seat-avatar { width: 78rpx; height: 78rpx; border-radius: 23rpx; font-size: 30rpx; box-shadow: 0 8rpx 22rpx rgba(0, 0, 0, .2); }
.rating-badge { flex: none; padding: 7rpx 9rpx; border: 1rpx solid rgba(244, 197, 106, .28); border-radius: 999rpx; color: #ffe3a2; background: rgba(244, 197, 106, .1); font-size: 16rpx; white-space: nowrap; }
.seat-top .rating-badge { position: absolute; top: 8rpx; right: -78rpx; }
.capture-badge { flex: none; padding: 7rpx 9rpx; border: 1rpx solid rgba(159, 224, 201, .24); border-radius: 999rpx; color: #a9e5d9; background: rgba(88, 189, 160, .1); font-size: 16rpx; white-space: nowrap; }
.seat-top .capture-badge { position: absolute; top: 48rpx; right: -78rpx; }
.seat-left .seat-avatar { color: #fff0df; background: linear-gradient(145deg, #d18d7b, #784d4c); }
.seat-right .seat-avatar { color: #fff0df; background: linear-gradient(145deg, #bba378, #6b5333); }
.seat-bottom .seat-avatar { color: #fff0df; background: linear-gradient(145deg, #ef9c70, #9f443d); }
.seat.is-turn .seat-avatar { outline: 3rpx solid #f4c56a; outline-offset: 5rpx; box-shadow: 0 0 0 11rpx rgba(244, 197, 106, .12), 0 10rpx 28rpx rgba(244, 197, 106, .25); }
.seat-text { max-width: 175rpx; }
.seat-name { color: #f8e6b7; font-size: 23rpx; font-weight: 800; }
.seat-state { display: block; margin-top: 6rpx; color: #94b4af; font-size: 17rpx; white-space: nowrap; }
.dealer, .team-tag { display: inline-block; margin-left: 8rpx; padding: 4rpx 8rpx; border-radius: 999rpx; font-size: 15rpx; }
.dealer { color: #33220b; background: #f4c56a; }
.team-tag { margin: 6rpx 0 0; color: #a9e5d9; background: rgba(55, 153, 137, .2); }
.call-badge { display: inline-block; padding: 4rpx 8rpx; border: 1rpx solid rgba(255, 159, 138, .24); border-radius: 999rpx; color: #ffd3a7; background: rgba(216, 94, 75, .23); font-size: 15rpx; }
.seat-tags { display: flex; flex-wrap: wrap; gap: 6rpx; margin-top: 7rpx; }
.seat-right .seat-tags { justify-content: flex-end; }
.finish-badge, .joker-badge { display: inline-block; padding: 4rpx 8rpx; border-radius: 999rpx; font-size: 15rpx; }
.finish-badge { color: #17251f; background: #a9e5d9; }
.joker-badge { color: #ffe9b1; background: rgba(126, 73, 53, .5); border: 1rpx solid rgba(255, 196, 119, .3); }
.trick-zone { position: absolute; z-index: 2; top: 43%; left: 50%; width: 68%; min-height: 230rpx; padding: 24rpx; transform: translate(-50%, -50%); border: 1rpx dashed rgba(255, 229, 165, .2); border-radius: 26rpx; background: rgba(4, 23, 25, .14); text-align: center; }
.trick-title { color: #f9e6b7; font-size: 24rpx; font-weight: 800; }
.trick-subtitle { margin-top: 10rpx; color: rgba(222, 244, 231, .65); font-size: 18rpx; line-height: 1.5; }
.played-row { display: flex; align-items: center; justify-content: center; min-height: 120rpx; margin-top: 4rpx; }
.played-card { position: relative; width: 72rpx; height: 102rpx; margin-left: -10rpx; padding: 11rpx 8rpx; border: 1rpx solid rgba(49, 37, 22, .24); border-radius: 11rpx; color: #24231f; background: linear-gradient(145deg, #fffdf7 5%, #f3ead7 100%); text-align: left; box-shadow: 0 7rpx 16rpx rgba(0, 0, 0, .22); }
.played-card:first-child { margin-left: 0; }
.played-card.red, .card-button .red { color: #c34842; }
.played-by { position: absolute; right: -7rpx; bottom: -9rpx; min-width: 26rpx; padding: 4rpx; border-radius: 999rpx; color: #203128; background: #f4c56a; font-size: 14rpx; text-align: center; }
.card-rank { font-size: 24rpx; font-weight: 800; }
.card-suit { margin-top: 3rpx; font-size: 17rpx; }
.trick-points { min-height: 25rpx; margin-top: 6rpx; color: #ffe3a2; font-size: 17rpx; }
.call-panel { position: absolute; z-index: 8; top: 47%; left: 50%; width: 72%; padding: 32rpx 24rpx; transform: translate(-50%, -50%); border: 1rpx solid rgba(244, 197, 106, .35); border-radius: 24rpx; background: rgba(6, 28, 29, .96); text-align: center; box-shadow: 0 25rpx 70rpx rgba(0, 0, 0, .36); }
.call-title { margin-top: 13rpx; color: #fff0c5; font-size: 34rpx; font-weight: 800; }
.call-desc { margin: 13rpx auto 24rpx; color: #94b4af; font-size: 20rpx; line-height: 1.6; }
.call-actions { display: flex; gap: 14rpx; justify-content: center; }
.call-actions button { flex: 1; }
.waiting-call { padding: 18rpx; border-radius: 14rpx; color: #acd6c4; background: rgba(88, 189, 160, .1); font-size: 20rpx; }
.hand-dock { position: absolute; right: 18rpx; bottom: 18rpx; left: 18rpx; z-index: 4; padding: 20rpx 16rpx 14rpx; border: 1rpx solid rgba(255, 255, 255, .1); border-radius: 20rpx; background: linear-gradient(180deg, rgba(5, 22, 24, .65), rgba(5, 18, 20, .91)); }
.hand-title { display: flex; justify-content: space-between; color: #f9e6b7; font-size: 21rpx; font-weight: 800; }
.hand-title text { color: #94b4af; font-size: 17rpx; font-weight: 400; }
.hand-scroll { width: 100%; margin-top: 14rpx; white-space: nowrap; }
.hand-row { display: inline-flex; align-items: flex-end; min-width: 100%; padding: 12rpx 6rpx 4rpx; }
.card-button { position: relative; width: 108rpx; height: 144rpx; flex: none; margin-left: -13rpx; padding: 0; border: 0; background: transparent; }
.card-button:first-child { margin-left: 0; }
.card-button.selected { transform: translateY(-20rpx); z-index: 3; }
.playing-card { position: relative; display: block; width: 108rpx; height: 144rpx; padding: 12rpx 10rpx; overflow: hidden; border: 1rpx solid rgba(49, 37, 22, .24); border-radius: 13rpx; color: #24231f; background: linear-gradient(145deg, #fffdf7 5%, #f3ead7 100%); text-align: left; box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, .22); }
.playing-card .card-rank { font-size: 28rpx; }
.playing-card .card-suit { font-size: 19rpx; }
.card-center { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); opacity: .13; font-size: 44rpx; }
.joker .card-center { color: #d85e4b; opacity: .8; }
.action-bar { gap: 18rpx; margin-top: 20rpx; }
.action-hint { flex: 1; color: #a9c7bd; font-size: 20rpx; line-height: 1.5; }
.action-buttons { display: flex; gap: 10rpx; }
.action-buttons button { width: 150rpx; padding-left: 0; padding-right: 0; }
.tool-row { justify-content: flex-start; gap: 26rpx; margin: 12rpx 0 22rpx; }
.tiny-btn { margin: 0; padding: 8rpx 0; color: #94b4af; background: transparent; }
.tiny-btn.highlight { color: #ffe3a2; }
.info-card, .log-card { padding: 24rpx; }
.info-head { color: #ffe3a2; font-size: 22rpx; font-weight: 800; }
.info-line, .personal-line { display: flex; justify-content: space-between; gap: 12rpx; margin-top: 14rpx; color: #94b4af; font-size: 19rpx; }
.info-line text:last-child, .personal-line text:last-child { color: #e9f3df; }
.personal-list { margin-top: 20rpx; padding-top: 10rpx; border-top: 1rpx solid rgba(255, 255, 255, .08); }
.personal-line { font-size: 17rpx; }
.personal-line.mine text:first-child { color: #ffe3a2; }
.log-card { margin-bottom: 20rpx; }
.log-scroll { height: 220rpx; margin-top: 14rpx; }
.log-line { display: flex; gap: 12rpx; margin-bottom: 12rpx; color: #c7d8cb; font-size: 18rpx; line-height: 1.4; }
.log-line text:first-child { flex: none; color: #739991; font-size: 16rpx; }
.result-card { position: fixed; z-index: 20; top: 50%; left: 50%; width: 78%; padding: 34rpx 28rpx; transform: translate(-50%, -50%); border: 1rpx solid rgba(244, 197, 106, .42); border-radius: 24rpx; background: rgba(8, 31, 31, .98); text-align: center; box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, .45); }
.result-label { display: inline-block; padding: 10rpx 20rpx; border-radius: 999rpx; color: #2d2716; background: linear-gradient(135deg, #ffe8a7, #e9b950); font-size: 22rpx; font-weight: 900; letter-spacing: .12em; }
.result-title { margin: 18rpx 0 10rpx; color: #fff0c5; font-size: 34rpx; font-weight: 800; }
.result-desc { color: #94b4af; font-size: 19rpx; line-height: 1.7; }
.result-score { display: flex; justify-content: center; gap: 65rpx; margin: 22rpx 0; color: #94b4af; font-size: 18rpx; }
.result-score strong { display: block; margin-top: 5rpx; color: #ffe3a2; font: 900 50rpx/1 Georgia, serif; }
.result-rating { margin-bottom: 22rpx; color: #a9c7bd; font-size: 18rpx; }
.mask { position: fixed; z-index: 30; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; padding: 28rpx; background: rgba(3, 15, 17, .78); }
.rules-card { width: 100%; max-height: 85vh; padding: 28rpx; overflow-y: auto; border: 1rpx solid rgba(244, 197, 106, .3); border-radius: 24rpx; background: #0c292a; }
.rules-head { display: flex; align-items: center; justify-content: space-between; gap: 15rpx; margin-bottom: 22rpx; }
.rule-block { margin-top: 14rpx; padding: 20rpx; border-radius: 16rpx; color: #b9d0c5; background: rgba(255, 255, 255, .045); font-size: 20rpx; line-height: 1.7; }
.rule-title { margin-bottom: 8rpx; color: #ffe3a2; font-size: 22rpx; font-weight: 800; }

@media (max-width: 700px) {
  .room-grid { grid-template-columns: repeat(2, 1fr); }
  .table { height: 1050rpx; }
  .seat-left, .seat-right { top: 35%; }
  .trick-zone, .call-panel { width: 82%; }
  .score-members { max-width: 190rpx; }
}
